+    df = nflmod.load_season(int(at.multiselect(key="nfl_seasons").value[-1]))
+    wr = df[df.position == "WR"].groupby("player_id")["receiving_yards"].sum().idxmax()
+    qb = df[df.position == "QB"].groupby("player_id")["passing_yards"].sum().idxmax()
